es lo normal en un súper), la\n","interpretación probablemente es correcta."],"metadata":{"id":"oTtEvvLw5-Dq"}},{"cell_type":"code","source":[],"metadata":{"id":"uyLtViTz5hFW","executionInfo":{"status":"ok","timestamp":1788974522092,"user_tz":-120,"elapsed":6,"user":{"displayName":"Marc","userId":"01955135890223556168"}}},"execution_count":13,"outputs":[]},{"cell_type":"code","source":["causal_con_dept = df['causal'].merge(\n","    df['products'][['PRODUCT_ID', 'DEPARTMENT']],\n","    on='PRODUCT_ID',\n","    how='left'\n",")\n","\n","causal_con_dept['sin_promo'] = (\n","    causal_con_dept['display'].isin(['0', 'A']) &\n","    (causal_con_dept['mailer'] == '0')\n",").astype(int)"],"metadata":{"id":"D7Rb7isv6eHR","executionInfo":{"status":"ok","timestamp":1788974530955,"user_tz":-120,"elapsed":8866,"user":{"displayName":"Marc","userId":"01955135890223556168"}}},"execution_count":14,"outputs":[]},{"cell_type":"code","source":["resumen = causal_con_dept.groupby(['DEPARTMENT', 'WEEK_NO'])['sin_promo'].mean().reset_index()\n","resumen.columns = ['DEPARTMENT', 'WEEK_NO', 'pct_sin_promo']\n","resumen.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":206},"id":"mm30kdFQ6gr8","executionInfo":{"status":"ok","timestamp":1788974535493,"user_tz":-120,"elapsed":4084,"user":{"displayName":"Marc","userId":"01955135890223556168"}},"outputId":"063bc815-e568-46a8-ec1a-c93d1d9ccf11"},"execution_count":15,"outputs":[{"output_type":"execute_result","data":{"text/plain":["        DEPARTMENT  WEEK_NO  pct_sin_promo\n","0  CHARITABLE CONT       17       0.000000\n","1  CHARITABLE CONT       18       0.000000\n","2  CHARITABLE CONT       19       0.058824\n","3  CHARITABLE CONT       20       0.062500\n","4  CHARITABLE CONT       21       0.000000"],"text/html":["\n","  <div id=\"df-8b42bbf9-1261-4d17-84a2-e7813b73b29d\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n